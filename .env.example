DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# Локальный запуск через Docker работает по HTTP, поэтому HTTPS-флаги выключены.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

# PostgreSQL по умолчанию.
DJANGO_DB_ENGINE=postgresql
DJANGO_DB_NAME=
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=db
DJANGO_DB_PORT=5432

# Внешний порт Nginx на хосте.
NGINX_PORT=80

# Локальная проверка без PostgreSQL:
# DJANGO_DB_ENGINE=sqlite
# DJANGO_SQLITE_NAME=db.sqlite3
